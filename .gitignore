# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# NB: this already covers .env.sentry-build-plugin, which the Sentry build
# plugin writes the auth token into.
.env*
!.env.example

# sentry
.sentryclirc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
