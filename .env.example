# ─────────────────────────────────────────────────────────────────────────────
# BAKED AT BUILD TIME (passed as Docker build args)
#
# Next.js inlines every NEXT_PUBLIC_* value into the client bundle, so these
# are public by definition and are visible to anyone who can pull the image.
# They also make the image environment-specific: an image built with test
# values IS a test image and must never be retagged for production.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare Turnstile site key — public, it ships in the page. Locally use
# Cloudflare's always-pass TEST key below, which pairs with the test secret in
# supabase/config.toml. The real key is created in the Cloudflare dashboard for
# the deployed hostname (docs/deployment/AUTH_SETUP.md). The matching SECRET
# never appears here: Supabase Auth verifies tokens itself.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Which Sentry environment events are tagged with. CI hardcodes `production`;
# phase 2 sets `test` on the test host so the two never share an issue stream.
# Defaults to NODE_ENV when unset.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Sentry identifiers — build-time only, not shipped in the bundle.
SENTRY_ORG=
SENTRY_PROJECT=

# SENTRY_AUTH_TOKEN is a credential and is NOT in the build-arg list above.
# CI exports intermediate builder layers to the Actions cache (mode=max), so an
# ARG/ENV token is recoverable from that cache. Pass it as a BuildKit secret
# mount instead. Locally it is just an env var; it only needs to exist when you
# want sourcemaps uploaded.
SENTRY_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME ONLY (set in Coolify — NEVER a build arg)
#
# Passing any of these as a build arg bakes them into the image layers, where
# they are readable by anyone who can pull it. That is a credential leak
# regardless of how the container is later run.
# ─────────────────────────────────────────────────────────────────────────────
# Server/edge DSN. Optional — the runtimes fall back to NEXT_PUBLIC_SENTRY_DSN.
# Set it here only when you want the server DSN rotatable without a rebuild.
SENTRY_DSN=

SUPABASE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional. Unset in production (the endpoint is derived from R2_ACCOUNT_ID and
# the region is "auto"). Locally, Supabase Storage's S3 endpoint stands in for
# R2 — set the block below instead of R2_ACCOUNT_ID, taking the two keys from
# `npx supabase status -o env` (S3_PROTOCOL_ACCESS_KEY_ID / _SECRET):
#   R2_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
#   R2_REGION=local
#   R2_BUCKET_NAME=card-photos
#   R2_ACCESS_KEY_ID=<S3_PROTOCOL_ACCESS_KEY_ID>
#   R2_SECRET_ACCESS_KEY=<S3_PROTOCOL_ACCESS_KEY_SECRET>
R2_ENDPOINT=
R2_REGION=
MEILISEARCH_HOST=
MEILISEARCH_MASTER_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=

# Development only. Extra addresses allowed to load `next dev`'s scripts, for
# a dev server reached by another name (e.g. a headless box over Tailscale).
# Comma-separated hostnames or IPs; unset means localhost only.
DEV_ALLOWED_ORIGINS=

# Public origin of this deployment. A RUNTIME server setting (never NEXT_PUBLIC_,
# never a build arg). Printed parcel-label QR codes point at it, so in production
# it must be the real public origin.
SITE_URL=http://localhost:3000

# RUNTIME server setting (never a build arg). Bearer token for
# POST /api/jobs/maintenance, called hourly by a Coolify scheduled task. When
# unset the route returns 404. Generate with `openssl rand -hex 32`.
JOBS_SECRET=

# RUNTIME-only switch, deliberately absent from the list above: `fake` enables
# the test payment page. In production it must be unset or a real provider id,
# NEVER `fake`.
# PAYMENT_PROVIDER=
